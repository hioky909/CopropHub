{
  "name": "coprophub",
  "private": true,
  "version": "0.1.0",
  "description": "CopropHub — gestion de copropriété (syndic, conseil syndical, copropriétaires). Projet Make-Your-Own RNCP 37873.",
  "workspaces": [
    "apps/backend",
    "apps/frontend"
  ],
  "scripts": {
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspace=apps/backend",
    "build": "npm run build --workspaces --if-present",
    "prisma:migrate:deploy": "npm run prisma:migrate:deploy --workspace=apps/backend",
    "prisma:generate": "npm run prisma:generate --workspace=apps/backend",
    "dev:backend": "npm run dev --workspace=apps/backend",
    "dev:frontend": "npm run dev --workspace=apps/frontend"
  },
  "engines": {
    "node": ">=20"
  }
}
