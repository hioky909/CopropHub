# Copier ce fichier en .env et renseigner des valeurs réelles.
# Ne jamais committer .env (voir .gitignore).

# Base de données (backend, Docker Compose)
DB_PASSWORD=change-me
# Port PostgreSQL publié sur la machine hôte par docker compose. À changer
# (ex. 5433) si un PostgreSQL local occupe déjà 5432 ; le port de DATABASE_URL
# ci-dessous (utilisé par le seed et les outils lancés depuis l'hôte) doit suivre.
DB_PORT=5432
DATABASE_URL=postgresql://coprophub:change-me@localhost:5432/coprophub

# Session (cookie HttpOnly/Secure/SameSite=Strict — cf. Doc 5 Modèle de menace & sécurité)
SESSION_SECRET=change-me-to-a-long-random-string

# Redis (Docker Compose) : révocation de session et rate limiting PARTAGÉS entre instances.
# Strictement optionnel — absent, le backend se rabat automatiquement sur un état en mémoire
# du processus (mono-instance, suffisant en développement).
REDIS_URL=redis://localhost:6379

# Envoi d'emails (mot de passe oublié). En Docker Compose local, Mailpit est déjà
# branché (interface http://localhost:8025) : ces variables ne servent qu'en dehors
# de Docker ou en production, avec le serveur SMTP de votre choix.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="CopropHub <no-reply@example.org>"
# APP_URL=https://coprophub.example.org

# Nombre de proxys de confiance devant le backend (1 avec l'installation de production fournie,
# 0 par défaut : l'en-tête X-Forwarded-For est alors ignoré). Voir docs/11-devops.
# TRUST_PROXY=1

# Backend
PORT=3000
NODE_ENV=development
# Origine autorisée par CORS pour le frontend (doit correspondre à VITE_API_URL côté frontend)
FRONTEND_ORIGIN=http://localhost:5173

# Frontend (optionnel, défaut http://localhost:3000)
VITE_API_URL=http://localhost:3000
