# Copier ce fichier en .env et renseigner des valeurs réelles.
# Ne jamais committer .env (voir .gitignore).

# Base de données (backend, Docker Compose)
DB_PASSWORD=change-me
DATABASE_URL=postgresql://coprophub:change-me@localhost:5432/coprophub

# Session (cookie HttpOnly/Secure/SameSite=Strict — cf. Doc 5 Modèle de menace & sécurité)
SESSION_SECRET=change-me-to-a-long-random-string

# Backend
PORT=3000
NODE_ENV=development
