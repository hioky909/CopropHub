# Configuration de PRODUCTION — copier en `.env.production` (jamais committé, cf. .gitignore) et
# renseigner de vraies valeurs. Utilisé avec :
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d

# Nom de domaine public (le DNS doit pointer vers cette machine ; ports 80 et 443 ouverts).
DOMAINE=copro.example.org

# Mot de passe de la base : hexadécimal (pas de caractère spécial : il est placé dans une URL).
#   openssl rand -hex 24
DB_PASSWORD=

# Signature du cookie de session : longue chaîne aléatoire, à ne jamais partager ni changer sans
# raison (la changer déconnecte tout le monde).
#   openssl rand -base64 48
SESSION_SECRET=

# Emails (mot de passe oublié, notifications) : le serveur SMTP de votre choix. Sans SMTP_HOST,
# aucun email n'est envoyé (les actions fonctionnent, sans courriel).
# SMTP_HOST=smtp.example.org
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="CopropHub <no-reply@copro.example.org>"

# Premier compte syndic et immeuble, à l'amorçage uniquement (aucune valeur par défaut en
# production ; mot de passe d'au moins 12 caractères, à changer ensuite depuis « Mon compte »).
#   docker compose -f docker-compose.prod.yml --env-file .env.production --profile outils run --rm seed
SEED_IMMEUBLE_NOM=
SEED_IMMEUBLE_ADRESSE=
SEED_SYNDIC_NOM=
SEED_SYNDIC_EMAIL=
SEED_SYNDIC_MOT_DE_PASSE=

# Images publiées par la CI (facultatif : sans cela, `up --build` construit sur la machine).
# IMAGE_PREFIX=ghcr.io/votre-organisation/coprophub
# IMAGE_TAG=latest

# Facultatif : plafond global de requêtes par fenêtre de 15 minutes (défaut 1000).
# RATE_LIMIT_MAX=1000
# Facultatif : ports publiés (défaut 80 et 443), pour un essai sur un poste où ils sont occupés.
# HTTP_PORT=80
# HTTPS_PORT=443
